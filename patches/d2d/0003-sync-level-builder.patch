         || !std::ranges::contains(kBuiltLevels, id)) return;
+    #ifdef D2WEB
+    // No threads: a wanted level is queued, and poll_levels() builds one per call (a frame hitch each, not all
+    // the neighbours at once); level() builds a queued one at once when someone needs it.
+    if (!std::ranges::contains(builder->web_pending, id)) builder->web_pending.push_back(id);
