+#ifdef D2WEB
+// Builds level `id` inline into a ready future (claimed first: the build can re-enter want_level).
+static void d2web_build(const GameData& game_data, int id) {
+    auto& job = game_data.builder->jobs[id];
+    job = d2web::run_now([&game_data, id] { return build_level(game_data, *game_data.builder, id); });
+}
