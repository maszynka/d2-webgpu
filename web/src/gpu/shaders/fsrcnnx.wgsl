// (LICENSES/FSRCNNX-LGPL-3.0.txt). WGSL port of FSRCNNX_x2_8-0-4-1.glsl, an mpv user shader. The network structure is the
// original's: the 14 hook passes are merged into 7 compute dispatches (the two 4-channel halves of each 8-channel layer
// are computed together; sub-pixel convolution and aggregation are one pass computing only the needed output channel).
// The weights are not inlined: they live in a storage buffer (web/public/fsrcnnx-8-0-4-1.bin, generated by
// scripts/fsrcnnx-extract.mjs; layout in fsrcnnx-layout.ts). Offsets arrive as pipeline-overridable constants, in vec4
// units (float offset / 4). Feature maps are rgba16float 2-layer array textures (layer 0 = channels 0-3, layer 1 = 4-7).
//
// Border handling matches mpv: every tap is clamped to the texture edge (clamp-to-edge sampling).
// GLSL mat4 * vec4 is column-major, exactly WGSL's mat4x4f * vec4f; the weight blocks store the 16 floats in GLSL order.
//
// Per output half h (0|1): bias at H_BIAS, optional PReLU alphas at H_PRELU, terms from H_TERMS. Terms are ordered x-major,
// then y, then input layer; the term for tap (dx,dy) and input layer k of an r-radius kernel is
// (((dx+r)*(2r+1) + (dy+r)) * 2 + k) for the 4x4-matrix layers and ((dx+2)*5 + (dy+2)) for the luma layer.

@group(0) @binding(0) var<storage, read> W: array<vec4f>;

override A_BIAS: u32 = 0u;
override A_PRELU: u32 = 0u;
override A_TERMS: u32 = 0u;
override B_BIAS: u32 = 0u;
override B_PRELU: u32 = 0u;
override B_TERMS: u32 = 0u;

const LUMA709 = vec3f(0.2126, 0.7152, 0.0722);

fn mat_at(i: u32) -> mat4x4f {
  return mat4x4f(W[i], W[i + 1u], W[i + 2u], W[i + 3u]);
}
fn prelu(x: vec4f, alpha_at: u32) -> vec4f {
  return max(x, vec4f(0.0)) + W[alpha_at] * min(x, vec4f(0.0));
}
fn clampc(p: vec2i, dims: vec2u) -> vec2u {
  return vec2u(clamp(p, vec2i(0), vec2i(dims) - vec2i(1)));
}

// ---- pass 1: luma (BT.709 of the rgba8 frame) -> feature maps 1 and 2 (5x5 conv, scalar input) ----
@group(0) @binding(1) var src_rgb: texture_2d<f32>;
@group(0) @binding(2) var in_map: texture_2d_array<f32>;
@group(0) @binding(3) var in_skip: texture_2d_array<f32>;
@group(0) @binding(4) var out_arr: texture_storage_2d_array<rgba16float, write>;
@group(0) @binding(5) var out_rgb: texture_storage_2d<rgba8unorm, write>;

@compute @workgroup_size(8, 8)
fn features(@builtin(global_invocation_id) gid: vec3u) {
  let dims = textureDimensions(src_rgb);
  if (gid.x >= dims.x || gid.y >= dims.y) { return; }
  let p = vec2i(gid.xy);
  var a = W[A_BIAS];
  var b = W[B_BIAS];
  for (var dx = -2; dx <= 2; dx++) {
    for (var dy = -2; dy <= 2; dy++) {
      let y = dot(textureLoad(src_rgb, clampc(p + vec2i(dx, dy), dims), 0).rgb, LUMA709);
      let t = u32((dx + 2) * 5 + (dy + 2));
      a += W[A_TERMS + t] * y;
      b += W[B_TERMS + t] * y;
    }
  }
  textureStore(out_arr, gid.xy, 0, a);
  textureStore(out_arr, gid.xy, 1, b);
}

// ---- passes 2-5: mapping layer, 8 -> 8 channels, 3x3, PReLU ----
@compute @workgroup_size(8, 8)
fn mapping(@builtin(global_invocation_id) gid: vec3u) {
  let dims = textureDimensions(in_map);
  if (gid.x >= dims.x || gid.y >= dims.y) { return; }
  let p = vec2i(gid.xy);
  var a = W[A_BIAS];
  var b = W[B_BIAS];
  for (var dx = -1; dx <= 1; dx++) {
    for (var dy = -1; dy <= 1; dy++) {
      let q = clampc(p + vec2i(dx, dy), dims);
      let t = u32(((dx + 1) * 3 + (dy + 1)) * 2);
      let v0 = textureLoad(in_map, q, 0, 0);
      let v1 = textureLoad(in_map, q, 1, 0);
      a += mat_at(A_TERMS + (t) * 4u) * v0 + mat_at(A_TERMS + (t + 1u) * 4u) * v1;
      b += mat_at(B_TERMS + (t) * 4u) * v0 + mat_at(B_TERMS + (t + 1u) * 4u) * v1;
    }
  }
  textureStore(out_arr, gid.xy, 0, prelu(a, A_PRELU));
  textureStore(out_arr, gid.xy, 1, prelu(b, B_PRELU));
}

// ---- pass 6: sub-band residuals, 1x1 (8 -> 8) + skip connection from the feature maps, PReLU ----
@compute @workgroup_size(8, 8)
fn residual(@builtin(global_invocation_id) gid: vec3u) {
  let dims = textureDimensions(in_map);
  if (gid.x >= dims.x || gid.y >= dims.y) { return; }
  let q = gid.xy;
  let v0 = textureLoad(in_map, q, 0, 0);
  let v1 = textureLoad(in_map, q, 1, 0);
  let a = W[A_BIAS] + mat_at(A_TERMS) * v0 + mat_at(A_TERMS + 4u) * v1 + textureLoad(in_skip, q, 0, 0);
  let b = W[B_BIAS] + mat_at(B_TERMS) * v0 + mat_at(B_TERMS + 4u) * v1 + textureLoad(in_skip, q, 1, 0);
  textureStore(out_arr, gid.xy, 0, prelu(a, A_PRELU));
  textureStore(out_arr, gid.xy, 1, prelu(b, B_PRELU));
}

// ---- pass 7: sub-pixel convolution (8 -> 4, 3x3) + aggregation (pixel shuffle) + chroma recombination ----
// Output pixel (ox,oy) takes channel (ox&1)*2 + (oy&1) of the sub-pixel convolution at texel (ox>>1, oy>>1): only that
// channel is computed. Chroma: the network replaces luma only; Cb/Cr are the bilinear 2x upscale of the source, which for
// a linear YCbCr transform is rgb_bilinear + (Y_net - Y_bilinear).
@compute @workgroup_size(8, 8)
fn aggregate(@builtin(global_invocation_id) gid: vec3u) {
  let odims = textureDimensions(out_rgb);
  if (gid.x >= odims.x || gid.y >= odims.y) { return; }
  let sdims = textureDimensions(src_rgb);
  let p = vec2i(gid.xy >> vec2u(1u));
  let c = ((gid.x & 1u) * 2u) + (gid.y & 1u);
  var acc = W[A_BIAS][c];
  for (var dx = -1; dx <= 1; dx++) {
    for (var dy = -1; dy <= 1; dy++) {
      let q = clampc(p + vec2i(dx, dy), sdims);
      let t = u32(((dx + 1) * 3 + (dy + 1)) * 2);
      let v0 = textureLoad(in_map, q, 0, 0);
      let v1 = textureLoad(in_map, q, 1, 0);
      let i0 = A_TERMS + t * 4u;
      let i1 = i0 + 4u;
      acc += dot(vec4f(W[i0][c], W[i0 + 1u][c], W[i0 + 2u][c], W[i0 + 3u][c]), v0);
      acc += dot(vec4f(W[i1][c], W[i1 + 1u][c], W[i1 + 2u][c], W[i1 + 3u][c]), v1);
    }
  }
  // bilinear 2x of the source colour at this output pixel centre
  let f = (vec2f(gid.xy) + 0.5) * 0.5 - 0.5;
  let f0 = floor(f);
  let w = f - f0;
  let i = vec2i(f0);
  let c00 = textureLoad(src_rgb, clampc(i, sdims), 0).rgb;
  let c10 = textureLoad(src_rgb, clampc(i + vec2i(1, 0), sdims), 0).rgb;
  let c01 = textureLoad(src_rgb, clampc(i + vec2i(0, 1), sdims), 0).rgb;
  let c11 = textureLoad(src_rgb, clampc(i + vec2i(1, 1), sdims), 0).rgb;
  let rgb = mix(mix(c00, c10, w.x), mix(c01, c11, w.x), w.y);
  let y_bil = dot(rgb, LUMA709);
  textureStore(out_rgb, gid.xy, vec4f(clamp(rgb + (acc - y_bil), vec3f(0.0), vec3f(1.0)), 1.0));
}
